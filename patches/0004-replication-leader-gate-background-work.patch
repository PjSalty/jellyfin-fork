index 0000000..c7470e3
--- /dev/null
+++ b/MediaBrowser.Common/Replication/ReplicaRole.cs
@@ -0,0 +1,30 @@
+using System;
+
+namespace MediaBrowser.Common.Replication;
+
+/// <summary>
+/// Exposes the replication role of this server process.
+/// </summary>
+/// <remarks>
+/// The role is read once from the <c>JELLYFIN_ROLE</c> environment variable. A process is the
+/// leader when the variable is unset, which keeps single node deployments unchanged, or when it
+/// is set to <c>leader</c>. Followers serve requests but do not arm background work on their own.
+/// </remarks>
+public static class ReplicaRole
+{
+    /// <summary>
+    /// The name of the environment variable that configures the replication role.
+    /// </summary>
+    public const string EnvironmentVariableName = "JELLYFIN_ROLE";
+
+    /// <summary>
+    /// Gets a value indicating whether this process is the leader replica.
+    /// </summary>
+    public static bool IsLeader { get; } = ReadIsLeader();
+
+    private static bool ReadIsLeader()
+    {
+        var role = Environment.GetEnvironmentVariable(EnvironmentVariableName);
+        return string.IsNullOrEmpty(role) || string.Equals(role, "leader", StringComparison.OrdinalIgnoreCase);
+    }
+}
