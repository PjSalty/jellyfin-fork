 namespace Jellyfin.LiveTv.Recordings;
 
@@ -13,21 +15,31 @@ public sealed class RecordingsHost : IHostedService
 {
     private readonly IRecordingsManager _recordingsManager;
     private readonly TimerManager _timerManager;
+    private readonly ILogger<RecordingsHost> _logger;
 
     /// <summary>
     /// Initializes a new instance of the <see cref="RecordingsHost"/> class.
     /// </summary>
     /// <param name="recordingsManager">The <see cref="IRecordingsManager"/>.</param>
     /// <param name="timerManager">The <see cref="TimerManager"/>.</param>
-    public RecordingsHost(IRecordingsManager recordingsManager, TimerManager timerManager)
+    /// <param name="logger">The <see cref="ILogger{RecordingsHost}"/>.</param>
+    public RecordingsHost(IRecordingsManager recordingsManager, TimerManager timerManager, ILogger<RecordingsHost> logger)
     {
         _recordingsManager = recordingsManager;
         _timerManager = timerManager;
+        _logger = logger;
     }
 
     /// <inheritdoc />
     public Task StartAsync(CancellationToken cancellationToken)
     {
+        if (!ReplicaRole.IsLeader)
+        {
+            _logger.LogInformation("Replica role is follower, Live TV recording timers stay disarmed on this instance");
+            return Task.CompletedTask;
+        }
+
+        _logger.LogInformation("Replica role is leader, Live TV recording timers will arm on this instance");
         _timerManager.RestartTimers();
         return _recordingsManager.CreateRecordingFolders();
     }
