From 92ac1b1b01022d34bc218ca238ad7060efd8cd09 Mon Sep 17 00:00:00 2001
From: Salty <99386653+PjSalty@users.noreply.github.com>
Date: Sat, 29 Aug 2026 12:54:54 -0500
Subject: [PATCH 11/11] items: count a season's children instead of
 materialising the series

Season.GetItemsInternal answers every query with a user by fetching every
episode of the whole series (Series.GetSeasonEpisodes), then filtering the
season out in memory and applying Limit, IsPlayed and IsVirtualItem there too.
Folder.FillUserDataDtoValues asks each Season DTO for its unplayed count with a
Limit=0 query, so a season strip for a 37-season show fetches the series 37
times, each fetch carrying every user's UserData rows. On a live library that
single statement was 1.62M calls at 20.5 ms, 55% of all database time, almost
all of it from listings that wanted one number per season.

The repository already has a count-only path for Limit=0 (it counts distinct
PresentationUniqueKeys and never fetches a row), but Season never reached it.
Hand it the predicate FilterEpisodesBySeason applies in memory:

  ParentIndexNumber = N, or SeasonId points at a Season row with this season's
  PresentationUniqueKey

expressed as a new InternalItemsQuery.SeasonMembership filter. The shortcut is
taken only for the count shape (Limit=0, EnableTotalRecordCount, no parent or
id scoping, Episode or untyped, nothing Folder would post-filter in memory),
only with DisplaySpecialsWithinSeasons on (the branch that queries by series
key), and only when the season has a number. Any other query keeps the
in-memory path.

AirsBefore/AirsAfterSeasonNumber move an episode into another season's listing
and live in the Data blob, so a series carrying any keeps the in-memory path
too; HasAiredSeasonOverride is the guard, a LIKE on the property name, which
is exact because Data is written with nulls omitted. Folder.RequiresPostFiltering
becomes protected so Season can ask the same question the base recursion asks.

Measured on the live library, worst case (1,022-episode series), warm cache:

  in-memory path   38 ms   12,292 buffers, 1,022 full rows serialised
  guard + count    12 ms    2,457 buffers, one row

Membership was checked across all 710 numbered seasons: every episode with a
numbered season is a member of the season its number names or the one its
SeasonId points at, the same two tests the in-memory filter runs. Counts still
differ from the in-memory path in two cases the fork accepts: duplicate episode
keys with different Played state per copy (none here), and items the SQL
parental filter admits but BaseItem.IsVisible would not (the same gap Series
counts have had all along).
---
 .../Item/BaseItemRepository.cs                | 16 +++++
 MediaBrowser.Controller/Entities/Folder.cs    |  2 +-
 .../Entities/InternalItemsQuery.cs            | 16 +++++
 MediaBrowser.Controller/Entities/TV/Season.cs | 69 +++++++++++++++++++
 4 files changed, 102 insertions(+), 1 deletion(-)

diff --git a/Jellyfin.Server.Implementations/Item/BaseItemRepository.cs b/Jellyfin.Server.Implementations/Item/BaseItemRepository.cs
index 648750cf..bf1fa9c6 100644
--- a/Jellyfin.Server.Implementations/Item/BaseItemRepository.cs
+++ b/Jellyfin.Server.Implementations/Item/BaseItemRepository.cs
@@ -1988,6 +1988,22 @@ public sealed class BaseItemRepository
             baseQuery = baseQuery.Where(e => e.ParentIndexNumber != filter.ParentIndexNumberNotEquals.Value || e.ParentIndexNumber == null);
         }
 
+        if (filter.SeasonMembership.HasValue)
+        {
+            var (seasonNumber, seasonKey) = filter.SeasonMembership.Value;
+            baseQuery = baseQuery.Where(e => e.ParentIndexNumber == seasonNumber
+                || context.BaseItems.Any(s => s.Id == e.SeasonId && s.PresentationUniqueKey == seasonKey));
+        }
+
+        if (filter.HasAiredSeasonOverride.HasValue)
+        {
+            // Data is written with JsonDefaults (nulls omitted), so the property name being
+            // present is the same as the override being set.
+            baseQuery = baseQuery.Where(e => (e.Data != null
+                && (EF.Functions.Like(e.Data, "%\"AirsAfterSeasonNumber\":%")
+                    || EF.Functions.Like(e.Data, "%\"AirsBeforeSeasonNumber\":%"))) == filter.HasAiredSeasonOverride.Value);
+        }
+
         var minEndDate = filter.MinEndDate;
         var maxEndDate = filter.MaxEndDate;
 
