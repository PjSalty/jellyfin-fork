diff --git a/MediaBrowser.Controller/Entities/InternalItemsQuery.cs b/MediaBrowser.Controller/Entities/InternalItemsQuery.cs
index 076a5929..9239add0 100644
--- a/MediaBrowser.Controller/Entities/InternalItemsQuery.cs
+++ b/MediaBrowser.Controller/Entities/InternalItemsQuery.cs
@@ -233,6 +233,22 @@ namespace MediaBrowser.Controller.Entities
 
         public int? ParentIndexNumberNotEquals { get; set; }
 
+        /// <summary>
+        /// Gets or sets the season an episode has to belong to: its ParentIndexNumber is the
+        /// number, or its SeasonId points at a Season row with that PresentationUniqueKey.
+        /// </summary>
+        /// <remarks>
+        /// The SQL form of <c>Series.FilterEpisodesBySeason</c>. AirsBefore/AirsAfter relocation
+        /// is not part of it (those live in the Data blob); see <see cref="HasAiredSeasonOverride"/>.
+        /// </remarks>
+        public (int ParentIndexNumber, string SeasonPresentationUniqueKey)? SeasonMembership { get; set; }
+
+        /// <summary>
+        /// Gets or sets a value indicating whether an episode carries an AirsBeforeSeasonNumber or
+        /// AirsAfterSeasonNumber override, which moves it into another season's listing.
+        /// </summary>
+        public bool? HasAiredSeasonOverride { get; set; }
+
         public int? IndexNumber { get; set; }
 
         public ParentalRatingScore? MinParentalRating { get; set; }
diff --git a/MediaBrowser.Controller/Entities/TV/Season.cs b/MediaBrowser.Controller/Entities/TV/Season.cs
index 4360253b..15278da5 100644
--- a/MediaBrowser.Controller/Entities/TV/Season.cs
+++ b/MediaBrowser.Controller/Entities/TV/Season.cs
@@ -175,6 +175,12 @@ namespace MediaBrowser.Controller.Entities.TV
 
             var user = query.User;
 
+            var counted = TryCountEpisodes(query);
+            if (counted is not null)
+            {
+                return counted;
+            }
+
             Func<BaseItem, bool> filter = i => UserViewBuilder.Filter(i, user, query, UserDataManager, LibraryManager);
 
             var items = GetEpisodes(user, query.DtoOptions, true).Where(filter);
@@ -182,6 +188,69 @@ namespace MediaBrowser.Controller.Entities.TV
             return PostFilterAndSort(items, query);
         }
 
+        /// <summary>
+        /// Answers a count-only query with a repository count instead of materialising the series.
+        /// </summary>
+        /// <remarks>
+        /// 2026-08-29: Folder.FillUserDataDtoValues asks every Season DTO for its unplayed count as a
+        /// Limit=0 query. The user branch above fetches every episode of the whole series, joined to
+        /// every user's UserData, and filters the season out in memory, so a 37-season show pays 37
+        /// full-series fetches per listing; that one statement was 55% of all database time. The
+        /// repository's Limit=0 path counts distinct PresentationUniqueKeys without fetching a row,
+        /// so hand it the predicate FilterEpisodesBySeason applies in memory. Returns null when the
+        /// query is not the count-only shape or the predicate cannot be expressed in SQL.
+        /// </remarks>
+        /// <param name="query">The query.</param>
+        /// <returns>The count result, or null to take the in-memory path.</returns>
+        private QueryResult<BaseItem> TryCountEpisodes(InternalItemsQuery query)
+        {
+            if (query.Limit != 0
+                || !query.EnableTotalRecordCount
+                || !IndexNumber.HasValue
+                || query.IsFolder == true
+                || !query.ParentId.IsEmpty()
+                || query.AncestorIds.Length > 0
+                || query.TopParentIds.Length > 0
+                || query.ItemIds.Length > 0
+                || query.ChannelIds.Count > 0
+                || query.ExcludeItemTypes.Length > 0
+                || (query.IncludeItemTypes.Length > 0 && !(query.IncludeItemTypes.Length == 1 && query.IncludeItemTypes[0] == BaseItemKind.Episode))
+                || RequiresPostFiltering(query)
+                || !ConfigurationManager.Configuration.DisplaySpecialsWithinSeasons)
+            {
+                return null;
+            }
+
+            var series = Series;
+            if (series is null || series.SourceType == SourceType.Channel)
+            {
+                return null;
+            }
+
+            var seriesKey = series.GetPresentationUniqueKey();
+
+            // AirsBefore/AirsAfter move an episode into another season's listing (FilterEpisodesBySeason
+            // reads AiredSeasonNumber for every season but specials). They live in the Data blob, so a
+            // series carrying any keeps the in-memory path.
+            if (IndexNumber.Value != 0
+                && LibraryManager.GetCount(new InternalItemsQuery
+                {
+                    SeriesPresentationUniqueKey = seriesKey,
+                    IncludeItemTypes = [BaseItemKind.Episode],
+                    HasAiredSeasonOverride = true
+                }) > 0)
+            {
+                return null;
+            }
+
+            query.AncestorWithPresentationUniqueKey = null;
+            query.SeriesPresentationUniqueKey = seriesKey;
+            query.IncludeItemTypes = [BaseItemKind.Episode];
+            query.SeasonMembership = (IndexNumber.Value, GetPresentationUniqueKey());
+
+            return LibraryManager.GetItemsResult(query);
+        }
+
         /// <summary>
         /// Gets the episodes.
         /// </summary>
