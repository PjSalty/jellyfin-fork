 .../20260915120000_MigrateRatingLevels.cs     | 39 +++++++++++++
 .../Migrations/MigrateRatingLevelsTests.cs    | 55 ++++++++++++++++++-
 2 files changed, 92 insertions(+), 2 deletions(-)

diff --git a/Jellyfin.Server/Migrations/Routines/20260915120000_MigrateRatingLevels.cs b/Jellyfin.Server/Migrations/Routines/20260915120000_MigrateRatingLevels.cs
index a4f6925..2932d4e 100644
--- a/Jellyfin.Server/Migrations/Routines/20260915120000_MigrateRatingLevels.cs
+++ b/Jellyfin.Server/Migrations/Routines/20260915120000_MigrateRatingLevels.cs
@@ -1,6 +1,8 @@
+using System;
 using System.Linq;
 using Jellyfin.Database.Implementations;
 using Jellyfin.Server.ServerSetupApp;
+using MediaBrowser.Controller.Entities.TV;
 using MediaBrowser.Model.Globalization;
 using Microsoft.EntityFrameworkCore;
 using Microsoft.Extensions.Logging;
@@ -16,6 +18,12 @@ namespace Jellyfin.Server.Migrations.Routines;
 #pragma warning restore CS0618 // Type or member is obsolete
 internal class MigrateRatingLevels : IDatabaseMigrationRoutine
 {
+    // A walk up the display parents ends at the library root long before this; the bound only stops a parent cycle.
+    private const int MaxInheritanceDepth = 16;
+
+    private static readonly string _episodeType = typeof(Episode).FullName!;
+    private static readonly string _seasonType = typeof(Season).FullName!;
+
     private readonly IStartupLogger _logger;
     private readonly IDbContextFactory<JellyfinDbContext> _provider;
     private readonly ILocalizationManager _localizationManager;
@@ -65,6 +73,37 @@ internal class MigrateRatingLevels : IDatabaseMigrationRoutine
             }
         }
 
+        // The loop leaves every item without a rating of its own unscored, and list queries filter on the stored
+        // score, so until such an item is next saved a limited profile is listed the seasons and episodes of shows
+        // above its limit. Hand each one the score of its display parent (episode -> season -> series, anything
+        // else -> parent), one level per pass, which is what OnMetadataChanged derives on a save. Items with a
+        // custom rating are left to that save: the loop above does not score custom ratings either.
+        var restored = 0;
+        for (var depth = 0; depth < MaxInheritanceDepth; depth++)
+        {
+            var filled = context.BaseItems
+                .Where(e => (e.OfficialRating == null || e.OfficialRating == string.Empty)
+                    && (e.CustomRating == null || e.CustomRating == string.Empty)
+                    && e.InheritedParentalRatingValue == null)
+                .Join(
+                    context.BaseItems.Where(p => p.InheritedParentalRatingValue != null
+                        && (p.CustomRating == null || p.CustomRating == string.Empty)),
+                    e => e.Type == _episodeType ? e.SeasonId : e.Type == _seasonType ? e.SeriesId : e.ParentId,
+                    p => (Guid?)p.Id,
+                    (e, p) => new { Item = e, Parent = p })
+                .ExecuteUpdate(f => f
+                    .SetProperty(x => x.Item.InheritedParentalRatingValue, x => x.Parent.InheritedParentalRatingValue)
+                    .SetProperty(x => x.Item.InheritedParentalRatingSubValue, x => x.Parent.InheritedParentalRatingSubValue));
+            if (filled == 0)
+            {
+                break;
+            }
+
+            restored += filled;
+        }
+
+        _logger.LogInformation("Restored the inherited parental rating level of {Count} items without a rating of their own.", restored);
+
         transaction.Commit();
     }
 }
