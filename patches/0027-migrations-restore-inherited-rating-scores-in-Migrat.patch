+    [Fact]
+    public void Perform_ItemsWithoutOwnRating_TakeTheScoreOfTheNearestRatedDisplayParent()
+    {
+        var series = AddItem("R", SeriesType);
+        var season = AddItem(null, SeasonType, seriesId: series);
+        var episode = AddItem(string.Empty, EpisodeType, seasonId: season, seriesId: series);
+        var ratedEpisode = AddItem("PG-13", EpisodeType, seasonId: season, seriesId: series);
+        var episodeWithoutSeason = AddItem(null, EpisodeType, seriesId: series);
+        var customSeason = AddItem(null, SeasonType, seriesId: series, customRating: "Family");
+        var episodeUnderCustomSeason = AddItem(null, EpisodeType, seasonId: customSeason, seriesId: series);
+        var ratedFolder = AddItem("PG-13", FolderType);
+        var subFolder = AddItem(null, FolderType, parentId: ratedFolder);
+        var nestedMovie = AddItem(null, MovieType, parentId: subFolder);
+        var movieUnderSeries = AddItem(null, MovieType, seriesId: series);
+
+        CreateMigration().Perform();
+
+        using var context = CreateDbContext();
+        var scores = context.BaseItems.ToDictionary(e => e.Id, e => (e.InheritedParentalRatingValue, e.InheritedParentalRatingSubValue));
+        Assert.Equal((17, (int?)1), scores[series]);
+        Assert.Equal((17, (int?)1), scores[season]);
+        Assert.Equal((17, (int?)1), scores[episode]);
+        Assert.Equal((13, (int?)null), scores[ratedEpisode]);
+        Assert.Equal((13, (int?)null), scores[subFolder]);
+        Assert.Equal((13, (int?)null), scores[nestedMovie]);
+
+        // An episode's display parent is its season and nothing else; only episodes and seasons follow SeriesId.
+        Assert.Equal(((int?)null, (int?)null), scores[episodeWithoutSeason]);
+        Assert.Equal(((int?)null, (int?)null), scores[movieUnderSeries]);
+
+        // A custom rating is scored by the next save, here and in the items below it.
