@@ -218,7 +219,7 @@ public class PlaystateController : BaseJellyfinApiController
     [ProducesResponseType(StatusCodes.Status204NoContent)]
     public async Task<ActionResult> ReportPlaybackProgress([FromBody] PlaybackProgressInfo playbackProgressInfo)
     {
-        playbackProgressInfo.PlayMethod = ValidatePlayMethod(playbackProgressInfo.PlayMethod, playbackProgressInfo.PlaySessionId);
+        playbackProgressInfo.PlayMethod = ValidatePlayMethod(playbackProgressInfo.PlayMethod, playbackProgressInfo.PlaySessionId, playbackProgressInfo.ItemId);
         playbackProgressInfo.SessionId = await RequestHelpers.GetSessionId(_sessionManager, _userManager, HttpContext).ConfigureAwait(false);
         await _sessionManager.OnPlaybackProgress(playbackProgressInfo).ConfigureAwait(false);
         return NoContent();
@@ -298,7 +299,7 @@ public class PlaystateController : BaseJellyfinApiController
             LiveStreamId = liveStreamId
         };
 
-        playbackStartInfo.PlayMethod = ValidatePlayMethod(playbackStartInfo.PlayMethod, playbackStartInfo.PlaySessionId);
+        playbackStartInfo.PlayMethod = ValidatePlayMethod(playbackStartInfo.PlayMethod, playbackStartInfo.PlaySessionId, playbackStartInfo.ItemId);
         playbackStartInfo.SessionId = await RequestHelpers.GetSessionId(_sessionManager, _userManager, HttpContext).ConfigureAwait(false);
         await _sessionManager.OnPlaybackStart(playbackStartInfo).ConfigureAwait(false);
         return NoContent();
@@ -386,7 +387,7 @@ public class PlaystateController : BaseJellyfinApiController
             RepeatMode = repeatMode ?? RepeatMode.RepeatNone
         };
 
-        playbackProgressInfo.PlayMethod = ValidatePlayMethod(playbackProgressInfo.PlayMethod, playbackProgressInfo.PlaySessionId);
+        playbackProgressInfo.PlayMethod = ValidatePlayMethod(playbackProgressInfo.PlayMethod, playbackProgressInfo.PlaySessionId, playbackProgressInfo.ItemId);
         playbackProgressInfo.SessionId = await RequestHelpers.GetSessionId(_sessionManager, _userManager, HttpContext).ConfigureAwait(false);
         await _sessionManager.OnPlaybackProgress(playbackProgressInfo).ConfigureAwait(false);
         return NoContent();
@@ -524,12 +525,12 @@ public class PlaystateController : BaseJellyfinApiController
         return _userDataRepository.GetUserDataDto(item, user);
     }
 
-    private PlayMethod ValidatePlayMethod(PlayMethod method, string? playSessionId)
+    private PlayMethod ValidatePlayMethod(PlayMethod method, string? playSessionId, Guid itemId)
     {
         if (method == PlayMethod.Transcode)
         {
             var job = string.IsNullOrWhiteSpace(playSessionId) ? null : _transcodeManager.GetTranscodingJob(playSessionId);
-            if (job is null)
+            if (job is null && !IsTranscodingItem(itemId))
             {
                 return PlayMethod.DirectPlay;
             }
@@ -537,4 +538,18 @@ public class PlaystateController : BaseJellyfinApiController
 
         return method;
     }
+
+    // A stream change or seek restart can report between the old job's kill and the new job's start.
+    private bool IsTranscodingItem(Guid itemId)
+    {
+        var userId = User.GetUserId();
+        var deviceId = User.GetDeviceId();
+        return !itemId.Equals(Guid.Empty)
+            && !string.IsNullOrEmpty(deviceId)
+            && _sessionManager.Sessions.Any(s => s.UserId.Equals(userId)
+                && string.Equals(s.DeviceId, deviceId, StringComparison.OrdinalIgnoreCase)
+                && s.NowPlayingItem is not null
+                && s.NowPlayingItem.Id.Equals(itemId)
+                && s.PlayState.PlayMethod == PlayMethod.Transcode);
+    }
 }
diff --git a/tests/Jellyfin.Api.Tests/Controllers/PlaystateControllerTests.cs b/tests/Jellyfin.Api.Tests/Controllers/PlaystateControllerTests.cs
new file mode 100644
index 0000000..ff49542
--- /dev/null
+++ b/tests/Jellyfin.Api.Tests/Controllers/PlaystateControllerTests.cs
@@ -0,0 +1,81 @@
+using System;
+using System.Security.Claims;
+using System.Threading.Tasks;
+using Jellyfin.Api.Constants;
+using Jellyfin.Api.Controllers;
+using Jellyfin.Database.Implementations.Entities;
+using MediaBrowser.Controller.Library;
+using MediaBrowser.Controller.MediaEncoding;
+using MediaBrowser.Controller.Session;
+using MediaBrowser.Model.Dto;
+using MediaBrowser.Model.Session;
+using Microsoft.AspNetCore.Http;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Api.Tests.Controllers;
+
+public class PlaystateControllerTests
+{
+    [Theory]
+    [InlineData(PlayMethod.Transcode, true, PlayMethod.Transcode)]
+    [InlineData(PlayMethod.DirectPlay, true, PlayMethod.DirectPlay)]
+    [InlineData(PlayMethod.Transcode, false, PlayMethod.DirectPlay)]
+    public async Task ReportPlaybackProgress_TranscodeWithoutJob_KeptOnlyForTheTranscodingItem(PlayMethod stored, bool sameItem, PlayMethod expected)
+    {
+        var userId = Guid.NewGuid();
+        var itemId = Guid.NewGuid();
+        var sessionManager = new Mock<ISessionManager>();
+        var session = new SessionInfo(sessionManager.Object, NullLogger.Instance)
+        {
+            Id = "session",
+            UserId = userId,
+            DeviceId = "device",
+            NowPlayingItem = new BaseItemDto { Id = itemId },
+            PlayState = new PlayerStateInfo { PlayMethod = stored },
+        };
+        sessionManager.Setup(m => m.Sessions).Returns(new[] { session });
+        sessionManager
+            .Setup(m => m.LogSessionActivity(It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<string>(), It.IsAny<User?>()))
+            .ReturnsAsync(session);
+        PlaybackProgressInfo? reported = null;
+        sessionManager
+            .Setup(m => m.OnPlaybackProgress(It.IsAny<PlaybackProgressInfo>()))
+            .Callback<PlaybackProgressInfo>(info => reported = info)
+            .Returns(Task.CompletedTask);
+
+        var controller = new PlaystateController(
+            Mock.Of<IUserManager>(),
+            Mock.Of<IUserDataManager>(),
+            Mock.Of<ILibraryManager>(),
+            sessionManager.Object,
+            NullLoggerFactory.Instance,
+            Mock.Of<ITranscodeManager>())
+        {
+            ControllerContext = new ControllerContext
+            {
+                HttpContext = new DefaultHttpContext
+                {
+                    User = new ClaimsPrincipal(new ClaimsIdentity(
+                        new[]
+                        {
+                            new Claim(InternalClaimTypes.UserId, userId.ToString("N")),
+                            new Claim(InternalClaimTypes.DeviceId, "device"),
+                        },
+                        "Test"))
+                }
+            }
+        };
+
+        await controller.ReportPlaybackProgress(new PlaybackProgressInfo
+        {
+            ItemId = sameItem ? itemId : Guid.NewGuid(),
+            PlayMethod = PlayMethod.Transcode,
+            PlaySessionId = "killed-job"
+        });
+
+        Assert.Equal(expected, reported?.PlayMethod);
+    }
+}
