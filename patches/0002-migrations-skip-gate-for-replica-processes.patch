diff --git a/tests/Jellyfin.Server.Tests/Migrations/SkipMigrationsGateTests.cs b/tests/Jellyfin.Server.Tests/Migrations/SkipMigrationsGateTests.cs
new file mode 100644
index 0000000..1b3a1e4
--- /dev/null
+++ b/tests/Jellyfin.Server.Tests/Migrations/SkipMigrationsGateTests.cs
@@ -0,0 +1,190 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Threading;
+using System.Threading.Tasks;
+using Jellyfin.Database.Implementations;
+using Jellyfin.Database.Implementations.Locking;
+using Jellyfin.Database.Providers.Sqlite;
+using Jellyfin.Server.Migrations;
+using Jellyfin.Server.Migrations.Stages;
+using Jellyfin.Server.ServerSetupApp;
+using MediaBrowser.Common.Configuration;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Migrations;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging.Abstractions;
+using Moq;
+using Xunit;
+
+namespace Jellyfin.Server.Tests.Migrations;
+
+/// <summary>
+/// Covers the JELLYFIN_SKIP_MIGRATIONS gate. The migrations assembly is this test assembly, standing in for an
+/// external database provider that ships its own migrations the way the PostgreSQL plugin does.
+/// </summary>
+public sealed class SkipMigrationsGateTests : IDisposable
+{
+    private const string SkipMigrationsVariable = "JELLYFIN_SKIP_MIGRATIONS";
+
+    private readonly string? _previousValue;
+    private readonly SqliteConnection _connection;
+    private readonly DbContextOptions<JellyfinDbContext> _dbOptions;
+
+    public SkipMigrationsGateTests()
+    {
+        // The variable is process-wide; tests in one class never run in parallel.
+        _previousValue = Environment.GetEnvironmentVariable(SkipMigrationsVariable);
+
+        _connection = new SqliteConnection("Data Source=:memory:");
+        _connection.Open();
+
+        _dbOptions = new DbContextOptionsBuilder<JellyfinDbContext>()
+            .UseSqlite(_connection, o => o.MigrationsAssembly(typeof(SkipGateProbeMigration).Assembly))
+            .Options;
+    }
+
+    private static CancellationToken Ct => TestContext.Current.CancellationToken;
+
+    public void Dispose()
+    {
+        Environment.SetEnvironmentVariable(SkipMigrationsVariable, _previousValue);
+        _connection.Dispose();
+    }
+
+    [Fact]
+    public async Task MigrateStep_GateSet_CountsTheProviderAssembly()
+    {
+        await StampCodeMigrationsAsync(null);
+        Environment.SetEnvironmentVariable(SkipMigrationsVariable, "true");
+
+        var ex = await Assert.ThrowsAsync<InvalidOperationException>(
+            () => CreateService().MigrateStepAsync(JellyfinMigrationStageTypes.PreInitialisation, EmptyServices()));
+
+        // The one pending migration only exists in the configured migrations assembly.
+        Assert.Contains($"{SkipMigrationsVariable} is set but there are 1 pending migrations", ex.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public async Task MigrateStep_GateSet_CountsCodeMigrationsOfEveryStage()
+    {
+        var laterStage = AllCodeMigrations().First(e => e.Metadata.Stage == JellyfinMigrationStageTypes.AppInitialisation);
+        await ApplyProbeMigrationAsync();
+        await StampCodeMigrationsAsync(laterStage.BuildCodeMigrationId());
+        Environment.SetEnvironmentVariable(SkipMigrationsVariable, "true");
+
+        var ex = await Assert.ThrowsAsync<InvalidOperationException>(
+            () => CreateService().MigrateStepAsync(JellyfinMigrationStageTypes.PreInitialisation, EmptyServices()));
+
+        Assert.Contains("there are 1 pending migrations", ex.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public async Task MigrateStep_GateSetAndNothingPending_ReturnsFalse()
+    {
+        await ApplyProbeMigrationAsync();
+        await StampCodeMigrationsAsync(null);
+        Environment.SetEnvironmentVariable(SkipMigrationsVariable, "true");
+
+        var service = CreateService();
+        foreach (var stage in Enum.GetValues<JellyfinMigrationStageTypes>())
+        {
+            // False keeps a gated replica from running the post-migration database optimisation.
+            Assert.False(await service.MigrateStepAsync(stage, EmptyServices()));
+        }
+    }
+
+    [Fact]
+    public async Task MigrateStep_GatePassedThenHistoryRolledBack_NewServiceThrows()
+    {
+        await ApplyProbeMigrationAsync();
+        await StampCodeMigrationsAsync(null);
+        Environment.SetEnvironmentVariable(SkipMigrationsVariable, "true");
+        Assert.False(await CreateService().MigrateStepAsync(JellyfinMigrationStageTypes.CoreInitialisation, EmptyServices()));
+
+        // A backup restore rewrites the history to an older set, then Program restarts in-process with a new service.
+        using (var context = CreateDbContext())
+        {
+            var historyRepository = context.GetService<IHistoryRepository>();
+            await context.Database.ExecuteSqlRawAsync(historyRepository.GetDeleteScript(SkipGateProbeMigration.Id), Ct);
+        }
+
+        var ex = await Assert.ThrowsAsync<InvalidOperationException>(
+            () => CreateService().MigrateStepAsync(JellyfinMigrationStageTypes.CoreInitialisation, EmptyServices()));
+        Assert.Contains("there are 1 pending migrations", ex.Message, StringComparison.Ordinal);
+    }
+
+    [Fact]
+    public async Task MigrateStep_GateUnset_RunsThePendingMigration()
+    {
+        await StampCodeMigrationsAsync(null);
+        Environment.SetEnvironmentVariable(SkipMigrationsVariable, null);
+
+        // The migration Job runs without the variable: the runner must still apply what is pending.
+        Assert.True(await CreateService().MigrateStepAsync(JellyfinMigrationStageTypes.CoreInitialisation, EmptyServices()));
+
+        using var context = CreateDbContext();
+        Assert.Contains(SkipGateProbeMigration.Id, await context.Database.GetAppliedMigrationsAsync(Ct));
+    }
+
+    private static IServiceProvider EmptyServices() => new ServiceCollection().BuildServiceProvider();
+
+    private static IEnumerable<CodeMigration> AllCodeMigrations()
+        => typeof(JellyfinMigrationService).Assembly.GetTypes()
+            .Select(e => (Type: e, Metadata: e.GetCustomAttribute<JellyfinMigrationAttribute>()))
+            .Where(e => e.Metadata is not null && !e.Type.IsAbstract)
+            .Select(e => new CodeMigration(e.Type, e.Metadata!, null));
+
+    private async Task ApplyProbeMigrationAsync()
+    {
+        using var context = CreateDbContext();
+        await context.GetService<IMigrator>().MigrateAsync(SkipGateProbeMigration.Id, Ct);
+    }
+
+    private async Task StampCodeMigrationsAsync(string? except)
+    {
+        using var context = CreateDbContext();
+        var historyRepository = context.GetService<IHistoryRepository>();
+        await historyRepository.CreateIfNotExistsAsync(Ct);
+        foreach (var id in AllCodeMigrations().Select(e => e.BuildCodeMigrationId()).Where(e => e != except))
+        {
+            await context.Database.ExecuteSqlRawAsync(historyRepository.GetInsertScript(new HistoryRow(id, "test")), Ct);
+        }
+    }
+
+    private JellyfinDbContext CreateDbContext() => new(
+        _dbOptions,
+        NullLogger<JellyfinDbContext>.Instance,
+        new SqliteDatabaseProvider(Mock.Of<IApplicationPaths>(), NullLogger<SqliteDatabaseProvider>.Instance),
+        new NoLockBehavior(NullLogger<NoLockBehavior>.Instance));
+
+    private JellyfinMigrationService CreateService()
+    {
+        var factory = new Mock<IDbContextFactory<JellyfinDbContext>>();
+        factory.Setup(f => f.CreateDbContext()).Returns(CreateDbContext);
+        factory.Setup(f => f.CreateDbContextAsync(It.IsAny<CancellationToken>())).ReturnsAsync(CreateDbContext);
+
+        return new JellyfinMigrationService(
+            factory.Object,
+            NullLoggerFactory.Instance,
+            new StartupLogger<JellyfinMigrationService>(NullLogger<JellyfinMigrationService>.Instance),
+            Mock.Of<IApplicationPaths>());
+    }
+
+    /// <summary>
+    /// The only migration in this test assembly, playing the part of a provider plugin's own migration.
+    /// </summary>
+    [DbContext(typeof(JellyfinDbContext))]
+    [Migration(Id)]
+    private sealed class SkipGateProbeMigration : Migration
+    {
+        public const string Id = "20990101000000_SkipGateProbe";
+
+        protected override void Up(MigrationBuilder migrationBuilder)
+        {
+        }
+    }
+}
