From d5dad881487246106672c5d580ab9fc2851e364b Mon Sep 17 00:00:00 2001
From: Salty <99386653+PjSalty@users.noreply.github.com>
Date: Sat, 29 Aug 2026 00:18:48 -0500
Subject: [PATCH] items: search plain terms with LIKE so a trigram index can
 serve them

The search filter's plain-term branch and the NameContains plain-term branch
both use string.Contains, which the PostgreSQL provider translates to
strpos() > 0. No index serves strpos, so every search is a sequential scan of
BaseItems; measured on a production library /Search/Hints took 0.93s alone and
4.8s p50 at 20 concurrent. The wildcard branches next to them already use
EF.Functions.Like, and a LIKE pattern is served by the trigram GIN index the
PostgreSQL provider now ensures on CleanName and lower(OriginalTitle).
Rewrite the plain-term branches to the equivalent LIKE form. The wildcard
check that selects these branches guarantees the term contains none of the
LIKE metacharacters, so the row set is unchanged; SQLite keeps working (LIKE
is supported there too) and single-node behavior is otherwise untouched.
---
 .../Item/BaseItemRepository.cs                  | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/Jellyfin.Server.Implementations/Item/BaseItemRepository.cs b/Jellyfin.Server.Implementations/Item/BaseItemRepository.cs
index 1db040a..cbbddf8 100644
--- a/Jellyfin.Server.Implementations/Item/BaseItemRepository.cs
+++ b/Jellyfin.Server.Implementations/Item/BaseItemRepository.cs
@@ -1857,7 +1857,15 @@ public sealed class BaseItemRepository
             }
             else
             {
-                baseQuery = baseQuery.Where(e => e.CleanName!.Contains(cleanedSearchTerm) || (e.OriginalTitle != null && e.OriginalTitle.ToLower().Contains(originalSearchTerm)));
+                // A plain term reaches the database as string.Contains, which the
+                // PostgreSQL provider emits as strpos() > 0: no index can serve it,
+                // so every search is a sequential scan of BaseItems. The same
+                // predicate as a LIKE pattern is served by a trigram index. The
+                // wildcard check above guarantees the term carries no LIKE
+                // metacharacters, so the two forms match the same rows.
+                var cleanedPattern = $"%{cleanedSearchTerm}%";
+                var originalPattern = $"%{originalSearchTerm}%";
+                baseQuery = baseQuery.Where(e => EF.Functions.Like(e.CleanName!, cleanedPattern) || (e.OriginalTitle != null && EF.Functions.Like(e.OriginalTitle.ToLower(), originalPattern)));
             }
         }
 
@@ -2091,9 +2099,12 @@ public sealed class BaseItemRepository
             }
             else
             {
+                // Same strpos() -> LIKE rewrite as the search term above, for the
+                // same trigram index; the wildcard check guarantees a literal term.
+                var namePattern = $"%{nameContains}%";
                 baseQuery = baseQuery.Where(e =>
-                                    e.CleanName!.Contains(nameContains)
-                                    || e.OriginalTitle!.ToLower().Contains(nameContains!));
+                                    EF.Functions.Like(e.CleanName!, namePattern)
+                                    || EF.Functions.Like(e.OriginalTitle!.ToLower(), namePattern));
             }
         }
 
