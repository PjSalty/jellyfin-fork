From 8a4c85a81122a358b0963171bf0c8d01112e9137 Mon Sep 17 00:00:00 2001
From: Salty <99386653+PjSalty@users.noreply.github.com>
Date: Tue, 14 Jul 2026 16:01:09 -0500
Subject: [PATCH] users: delete permissions and preferences on update instead
 of orphaning them

Permission.UserId and Preference.UserId are Guid? (optional), so
dbUser.Permissions.Clear() in UpdateUserAsync makes EF Core sever the
relationship -- UPDATE "Permissions" SET "UserId" = NULL -- rather than delete
the rows. Every call therefore leaves the user's previous 24 permission and 13
preference rows behind, permanently orphaned, and inserts a fresh set alongside.

The orphans are invisible from both directions, which is why this goes unnoticed:
every query filters on UserId and NULL matches nothing, and the
UNIQUE(UserId, Kind) index does not constrain them because a btree treats NULLs
as distinct. AccessSchedules, cleared three lines further down, does not leak,
because its FK is required (userId is a constructor argument) so EF emits DELETE.

Observed on a PostgreSQL install: 29,637 orphaned rows against 407 live ones.
The bloat skewed the planner (18M rows estimated vs 3,432 actual on the
Users/Permissions/Preferences join that backs every authenticated request),
pushing it past jit_above_cost so PostgreSQL LLVM-compiled it on every request:
617ms per call, against 3ms after the rows were removed. SQLite installs
accumulate the same rows; they just pay for it differently.

Remove the entities explicitly so EF emits DELETE.
---
 .../Users/UserManager.cs                      | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/Jellyfin.Server.Implementations/Users/UserManager.cs b/Jellyfin.Server.Implementations/Users/UserManager.cs
index 800413e..656a2b4 100644
--- a/Jellyfin.Server.Implementations/Users/UserManager.cs
+++ b/Jellyfin.Server.Implementations/Users/UserManager.cs
@@ -227,12 +227,33 @@ namespace Jellyfin.Server.Implementations.Users
                         ?? throw new ResourceNotFoundException(nameof(user.Id));
 
                     dbContext.Entry(dbUser).CurrentValues.SetValues(user);
+
+                    // Permission.UserId and Preference.UserId are Guid? (optional), so clearing
+                    // the navigation collection makes EF SEVER the relationship
+                    // (UPDATE ... SET "UserId" = NULL) instead of deleting the rows. The severed
+                    // rows are then unreachable forever: every query filters on UserId, and the
+                    // UNIQUE(UserId, Kind) index cannot see them either, because a btree treats
+                    // NULLs as distinct. AccessSchedules below does NOT leak, because its FK is
+                    // required (userId is a constructor argument), so EF deletes it -- same
+                    // Clear(), different outcome, which is what makes this easy to miss.
+                    //
+                    // Every call to this method orphaned 24 permissions + 13 preferences per
+                    // user. On a real install that reached 29,637 junk rows against 407 live
+                    // ones, which skewed the planner badly enough (18M rows estimated vs 3.4k
+                    // actual) that the user-load query behind EVERY authenticated request was
+                    // pushed past jit_above_cost and LLVM-compiled on each call: 617ms, against
+                    // 3ms once the rows were gone.
+                    //
+                    // Remove explicitly so EF emits DELETE, which is what Clear() is meant to do
+                    // here. ToList() snapshots the collection, because removing mutates it.
+                    dbContext.RemoveRange(dbUser.Permissions.ToList());
                     dbUser.Permissions.Clear();
                     foreach (var permission in user.Permissions)
                     {
                         dbUser.Permissions.Add(new Permission(permission.Kind, permission.Value));
                     }
 
+                    dbContext.RemoveRange(dbUser.Preferences.ToList());
                     dbUser.Preferences.Clear();
                     foreach (var preference in user.Preferences)
                     {
